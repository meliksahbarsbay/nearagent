# Copy to .env. Never commit .env.
# Everything is optional for dry mode: with no keys the advanced form still works.

# --- 1Click API (used today) ---
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Optional JWT. Without it an extra fee applies to real swaps.
ONECLICK_JWT=
# NEAR Intents account used as recipient and refund address in quotes.
# Dry mode needs no real account, so this placeholder is fine.
INTENTS_ACCOUNT_ID=dry-run.near

# --- Sentence parsing ---
# NEAR AI Cloud is tried first, then OpenAI. With neither, only the form works.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=
NEAR_AI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Agent API, live execution ---
# Mainnet only, real funds. Live mode stays off unless LIVE_ENABLED is true and the
# key, AGENT_ID and GRANT_TOKEN are all set.
LIVE_ENABLED=false
# The app's own limits, on top of the signed policy. The defaults are 5 and 10.
MAX_LIVE_USD=5
MAX_LIVE_DAILY_USD=10
NEAR_INTENTS_AGENT_API_URL=https://api.agentsonintents.com
# The partner key, starting with naa_. AGENT_API_KEY also works.
NEAR_INTENTS_AGENT_API_KEY=
# Written by scripts/owner/generate_key.mjs. Losing the private key cannot be undone.
OWNER_ACCOUNT_ID=
OWNER_PUBLIC_KEY=
OWNER_PRIVATE_KEY=
# RPC used to read the owner key's nonce when signing.
NEAR_RPC_URL=https://free.rpc.fastnear.com
# Written by scripts/owner_setup.py.
AGENT_ID=
GRANT_ID=
GRANT_TOKEN=

# --- Explorer links after a live operation ---
# Each can be left empty. {hash}, {address} and {account} are filled in by the app.
# The default for a transaction hash: https://nearblocks.io/txns/{hash}
EXPLORER_TX_URL=
# The default for a 1Click deposit address: https://explorer.near-intents.org/transactions/{address}
EXPLORER_INTENTS_URL=
# The default for the agent's intents account: https://nearblocks.io/address/{account}/mt-tokens
EXPLORER_ACCOUNT_URL=
