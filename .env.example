# Copy to .env. Never commit .env.
# Everything is optional for dry mode: the app runs with no keys at all.

# --- 1Click API (used today) ---
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Optional JWT. Without it an extra fee applies to real swaps.
ONECLICK_JWT=
# NEAR Intents account used as recipient and refund address in quotes.
# Dry mode needs no real account, so this placeholder is fine.
INTENTS_ACCOUNT_ID=dry-run.near

# --- NEAR AI Cloud, intent parsing (planned, not read yet) ---
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY=
# Fallback provider (planned, not read yet)
OPENAI_API_KEY=

# --- Agent API, live execution (planned, not read yet) ---
# Mainnet only, real funds. Live mode stays off until it is built and approved.
NEAR_INTENTS_AGENT_API_URL=https://api.agentsonintents.com
NEAR_INTENTS_AGENT_API_KEY=
OWNER_ACCOUNT_ID=
OWNER_PUBLIC_KEY=
AGENT_ID=
GRANT_TOKEN=
